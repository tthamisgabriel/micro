{
  "name": "restaurant-microfrontends",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n CONTAINER,CARDAPIO,PEDIDO -c blue,green,magenta \"npm run start --workspace @restaurant/container\" \"npm run start --workspace @restaurant/cardapio\" \"npm run start --workspace @restaurant/pedido\"",
    "start:container": "npm run start --workspace @restaurant/container",
    "start:cardapio": "npm run start --workspace @restaurant/cardapio",
    "start:pedido": "npm run start --workspace @restaurant/pedido",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-react": "^7.24.1",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.1",
    "html-webpack-plugin": "^5.6.0",
    "postcss": "^8.4.38",
    "postcss-loader": "^8.1.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
